# Copy to .env.local and fill in. Never commit the real file.
#
# From your Supabase project: Project Settings > API.
# Local development (supabase start) prints both values.
SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (formerly "anon key"). It is safe to expose; row-level security is what
# protects the data. Never put the secret / service_role key in this app.
SUPABASE_PUBLISHABLE_KEY=
